<Window
    x:Class="DLNACast.App.QuickSpeakerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,12,12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Text.PlaybackDevices}"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" />

            <Button Grid.Column="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Command="{Binding RefreshRenderersCommand}"
                    ToolTipService.ToolTip="{Binding Text.RefreshPlaybackDevices}"
                    AutomationProperties.Name="{Binding Text.RefreshPlaybackDevices}">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="12,0,12,12"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="RendererList"
                              ItemsSource="{Binding Renderers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,6"
                                    MinHeight="52"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                                    Background="{ThemeResource SubtleSurfaceBrush}">
                                <Grid>
                                    <CheckBox Content="{Binding FriendlyName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSelectionEnabled}"
                                              Visibility="{Binding NormalSelectionVisibility}"
                                              MinHeight="44"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              AutomationProperties.Name="{Binding FriendlyName}" />

                                    <Grid Visibility="{Binding StereoSelectionVisibility}"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding FriendlyName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1"
                                                  Content="L"
                                                  IsChecked="{Binding IsLeftChannel, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelectionEnabled}"
                                                  MinHeight="44"
                                                  ToolTipService.ToolTip="{Binding LeftChannelText}"
                                                  AutomationProperties.Name="{Binding LeftChannelSelectionAutomationName}" />
                                        <CheckBox Grid.Column="2"
                                                  Content="R"
                                                  IsChecked="{Binding IsRightChannel, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelectionEnabled}"
                                                  MinHeight="44"
                                                  ToolTipService.ToolTip="{Binding RightChannelText}"
                                                  AutomationProperties.Name="{Binding RightChannelSelectionAutomationName}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyState"
                        Visibility="Collapsed"
                        Padding="20,24"
                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                        Background="{ThemeResource SubtleSurfaceBrush}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE767;"
                                  FontSize="24"
                                  Foreground="{ThemeResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Text.NoPlaybackDevices}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextAlignment="Center"
                                   MaxWidth="280" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
