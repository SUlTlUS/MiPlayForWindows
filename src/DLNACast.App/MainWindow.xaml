<Window
    x:Class="DLNACast.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DLNA Cast for Windows">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="24,0,20,0" Background="#D90F1420">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="DLNA Cast" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Windows 实时音频投送" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="14" Background="#334F7CFF" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProfileText}" Foreground="#BFD1FF" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="28,24" Spacing="16">
                <Border Background="#33F59E0B" BorderBrush="#88F59E0B" BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="网络安全状态" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NetworkSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="重新检测" Command="{Binding RefreshNetworkCommand}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="网络设置" Command="{Binding OpenNetworkSettingsCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="1  选择 DLNA 音箱" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Renderers}" SelectedItem="{Binding SelectedRenderer, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="刷新设备" Command="{Binding RefreshRenderersCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="2  选择 Windows 音频" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="22">
                            <RadioButton Content="输出设备全部声音" IsChecked="{Binding IsSystemMode, Mode=TwoWay}" />
                            <RadioButton Content="应用及其子进程" IsChecked="{Binding IsProcessMode, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="刷新音源" Command="{Binding RefreshSourcesCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="3  音箱音量" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RemoteVolumeText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding RemoteVolume, Mode=TwoWay}" StepFrequency="1" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel Spacing="7">
                        <TextBlock Text="投送状态" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DiagnosticsText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorText}" Foreground="#FFFF8A80" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="28,12" Background="#E6111722">
            <TextBlock Text="关闭窗口后仍会在系统托盘运行" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button Content="{Binding CastButtonText}" Command="{Binding ToggleCastingCommand}"
                    HorizontalAlignment="Right" MinWidth="160" Background="{StaticResource BrandBrush}"
                    Foreground="White" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
