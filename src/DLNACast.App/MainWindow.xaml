<Window
    x:Class="DLNACast.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiPlay Cast">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <Storyboard x:Key="ActiveWaveformStoryboard">
                <DoubleAnimation Storyboard.TargetName="ActiveWaveBar1"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.45" To="1" Duration="0:0:0.28"
                                 AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="ActiveWaveBar2"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.35" To="1" Duration="0:0:0.34" BeginTime="0:0:0.06"
                                 AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="ActiveWaveBar3"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.5" To="1" Duration="0:0:0.24" BeginTime="0:0:0.12"
                                 AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="ActiveWaveBar4"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.4" To="1" Duration="0:0:0.31" BeginTime="0:0:0.03"
                                 AutoReverse="True" RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="ActiveWaveBar5"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                 From="0.55" To="1" Duration="0:0:0.26" BeginTime="0:0:0.1"
                                 AutoReverse="True" RepeatBehavior="Forever" />
            </Storyboard>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,142,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="28"
                   Height="28"
                   Source="ms-appx:///Assets/MiPlayMark.png"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Text.MiPlay}" />
            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="MiPlay Cast" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <Grid x:Name="PageLayout"
                  MaxWidth="1180"
                  Padding="32,24,32,32"
                  ColumnSpacing="20"
                  RowSpacing="20"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,4" Spacing="5">
                    <TextBlock Text="{Binding Text.PageHeading}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Text.PageSubtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
                </StackPanel>

                <StackPanel x:Name="WorkflowPanel" Grid.Row="1" Grid.Column="0" Spacing="16">
                    <Border MinHeight="164"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <Grid Padding="20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <FontIcon Width="20"
                                              Glyph="&#xE9D9;"
                                              FontSize="17"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Text.CastStatus}" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Border Padding="10,4"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Visibility="{Binding CastingStatusVisibility}"
                                            ToolTipService.ToolTip="{Binding Text.CastDuration}"
                                            AutomationProperties.Name="{Binding Text.CastDuration}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE121;"
                                                      FontSize="11"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CastDurationText}"
                                                       MinWidth="36"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="10,4"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8D6;"
                                                      FontSize="11"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding ProfileText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Rectangle Grid.Row="1"
                                       Height="1"
                                       Margin="0,14,0,14"
                                       Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid Grid.Row="2" MinHeight="44" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="40"
                                        Height="40"
                                        Background="{ThemeResource SubtleSurfaceBrush}"
                                        CornerRadius="20"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{Binding InactiveStatusVisibility}" />
                                        <FontIcon Glyph="&#xE102;"
                                                  FontSize="17"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  Visibility="{Binding CastingStatusVisibility}" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Grid>

                                <Grid Grid.Column="2" Width="60" Height="32" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding InactiveStatusVisibility}">
                                        <Border Width="3" Height="8" CornerRadius="2" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Border Width="3" Height="14" CornerRadius="2" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Border Width="3" Height="22" CornerRadius="2" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Border Width="3" Height="14" CornerRadius="2" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Border Width="3" Height="8" CornerRadius="2" Background="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding CastingStatusVisibility}">
                                        <Border x:Name="ActiveWaveBar1" Width="3" Height="10" CornerRadius="2"
                                                Background="{ThemeResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="ActiveWaveBar2" Width="3" Height="22" CornerRadius="2"
                                                Background="{ThemeResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="ActiveWaveBar3" Width="3" Height="30" CornerRadius="2"
                                                Background="{ThemeResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="ActiveWaveBar4" Width="3" Height="18" CornerRadius="2"
                                                Background="{ThemeResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="ActiveWaveBar5" Width="3" Height="12" CornerRadius="2"
                                                Background="{ThemeResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="3"
                                  Margin="0,8,0,0"
                                  ColumnSpacing="8"
                                  Visibility="{Binding DiagnosticsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Width="16" Glyph="&#xE9D2;" FontSize="11"
                                          Foreground="{ThemeResource MutedTextBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DiagnosticsText}" FontSize="11"
                                           Foreground="{ThemeResource MutedTextBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Border Grid.Row="4"
                                    Margin="0,10,0,0"
                                    Padding="10,7"
                                    Background="{ThemeResource ErrorSurfaceBrush}"
                                    BorderBrush="{ThemeResource ErrorTextBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding ErrorVisibility}"
                                    ToolTipService.ToolTip="{Binding ErrorText}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Width="16" Glyph="&#xEA39;" FontSize="12"
                                              Foreground="{ThemeResource ErrorTextBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ErrorText}" FontSize="11"
                                               Foreground="{ThemeResource ErrorTextBrush}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Text.Transport}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding Text.TransportHint}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                            </StackPanel>

                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Padding="14,10" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource SubtleSurfaceBrush}">
                                    <RadioButton GroupName="TransportMode" IsChecked="{Binding IsDlnaMode, Mode=TwoWay}" IsEnabled="{Binding CanChangeTransport}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="DLNA" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text.DlnaDescription}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Grid.Row="1" Padding="14,10" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource SubtleSurfaceBrush}">
                                    <RadioButton GroupName="TransportMode" IsChecked="{Binding IsMiPlayMode, Mode=TwoWay}" IsEnabled="{Binding CanChangeTransport}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Text.MiPlay}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text.MiPlayDescription}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text.AudioSource}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding Text.AudioSourceHint}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              MinWidth="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              Content="{Binding Text.SpeakersOnly}"
                                              IsChecked="{Binding IsSpeakerOnlyPlayback, Mode=TwoWay}"
                                              IsEnabled="{Binding CanUseSpeakerOnlyPlayback}"
                                              ToolTipService.ToolTip="{Binding Text.SpeakersOnlyTooltip}"
                                              AutomationProperties.Name="{Binding Text.SpeakersOnly}" />
                            </Grid>
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Padding="14,10" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource SubtleSurfaceBrush}">
                                    <RadioButton MinWidth="0"
                                                 IsEnabled="{Binding CanUseProcessCapture}"
                                                 IsChecked="{Binding IsSystemMode, Mode=TwoWay}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Text.AllOutputAudio}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text.AllOutputAudioDescription}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                                <Border Grid.Row="1" Padding="14,10" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource SubtleSurfaceBrush}">
                                    <RadioButton MinWidth="0"
                                                 IsChecked="{Binding IsProcessMode, Mode=TwoWay}"
                                                 IsEnabled="{Binding CanUseProcessCapture}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Text.AppAndChildren}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text.AppAndChildrenDescription}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="10" Visibility="{Binding AudioSourceSelectorVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Sources}"
                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                          IsEnabled="{Binding CanUseProcessCapture}"
                                          DisplayMemberPath="DisplayName"
                                          PlaceholderText="{Binding Text.NoAudioSources}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{Binding Text.AudioSource}" />
                                <Button Grid.Column="1" Command="{Binding RefreshSourcesCommand}" AutomationProperties.Name="{Binding Text.RefreshAudioSources}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="{Binding Text.Refresh}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Grid>

                </StackPanel>

                <StackPanel x:Name="DevicePanel" Grid.Row="1" Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text.PlaybackDevices}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding RendererSelectionText}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <ToggleButton Content="{Binding Text.StereoSplit}"
                                                  IsChecked="{Binding IsStereoSplitMode, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanUseStereoSplit}"
                                                  ToolTipService.ToolTip="{Binding Text.StereoSplitTooltip}"
                                                  AutomationProperties.Name="{Binding Text.StereoSplit}" />
                                    <Button Command="{Binding RefreshRenderersCommand}" AutomationProperties.Name="{Binding Text.RefreshPlaybackDevices}">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer x:Name="DeviceListScrollViewer"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16">
                                    <InfoBar IsOpen="{Binding HasNoRenderers}" IsClosable="False" Severity="Informational"
                                             Message="{Binding Text.NoPlaybackDevices}" />

                                    <ItemsControl ItemsSource="{Binding Renderers}"
                                                  Visibility="{Binding NormalRendererListVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="{ThemeResource OverlayCornerRadius}"
                                                Background="{ThemeResource SubtleSurfaceBrush}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  IsEnabled="{Binding IsSelectionEnabled}"
                                                                  MinWidth="0"
                                                                  AutomationProperties.Name="{Binding FriendlyName}" />
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding VolumeText}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider Margin="0" Minimum="0" Maximum="100"
                                                        Value="{Binding Volume, Mode=TwoWay}" StepFrequency="1"
                                                        IsEnabled="{Binding CanAdjustVolume}"
                                                        AutomationProperties.Name="{Binding SpeakerVolumeAutomationName}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Spacing="14" Visibility="{Binding StereoRendererListsVisibility}">
                                <Border Padding="12,10"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                        Background="{ThemeResource SubtleSurfaceBrush}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="{Binding StereoMasterVolumeLabel}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StereoMasterVolumeText}"
                                                       HorizontalAlignment="Right"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Slider Margin="0" Minimum="0" Maximum="100"
                                                Value="{Binding StereoMasterVolume, Mode=TwoWay}"
                                                StepFrequency="1"
                                                IsEnabled="{Binding CanAdjustStereoMasterVolume}"
                                                AutomationProperties.Name="{Binding StereoMasterVolumeAutomationName}" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="{Binding LeftChannelText}"
                                               FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level3" />
                                    <ItemsControl ItemsSource="{Binding Renderers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="12,10"
                                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                                        Background="{ThemeResource SubtleSurfaceBrush}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsLeftChannel, Mode=TwoWay}"
                                                                      IsEnabled="{Binding IsSelectionEnabled}"
                                                                      MinWidth="0"
                                                                      MinHeight="44"
                                                                      VerticalAlignment="Center"
                                                                      AutomationProperties.Name="{Binding LeftChannelSelectionAutomationName}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Margin="0" Minimum="0" Maximum="100"
                                                                Value="{Binding Volume, Mode=TwoWay}" StepFrequency="1"
                                                                IsEnabled="{Binding CanAdjustLeftChannelVolume}"
                                                                AutomationProperties.Name="{Binding LeftChannelVolumeAutomationName}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="{Binding RightChannelText}"
                                               FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level3" />
                                    <ItemsControl ItemsSource="{Binding Renderers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="12,10"
                                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                                        Background="{ThemeResource SubtleSurfaceBrush}">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsRightChannel, Mode=TwoWay}"
                                                                      IsEnabled="{Binding IsSelectionEnabled}"
                                                                      MinWidth="0"
                                                                      MinHeight="44"
                                                                      VerticalAlignment="Center"
                                                                      AutomationProperties.Name="{Binding RightChannelSelectionAutomationName}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Margin="0" Minimum="0" Maximum="100"
                                                                Value="{Binding Volume, Mode=TwoWay}" StepFrequency="1"
                                                                IsEnabled="{Binding CanAdjustRightChannelVolume}"
                                                                AutomationProperties.Name="{Binding RightChannelVolumeAutomationName}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}" Padding="18">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Text.TrayHint}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
